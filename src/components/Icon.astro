  lock: '<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>',
  receipt:'<path d="M7 3h10v18l-2-1.5L13 21l-2-1.5L9 21l-2-1.5V3Z"/><path d="M10 8h4M10 12h4"/>',
  wave: '<path d="M3 12c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0"/><path d="M3 17c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0"/>',
  globe:'<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.8 2.6 4 5.6 4 8.5s-1.2 5.9-4 8.5c-2.8-2.6-4-5.6-4-8.5s1.2-5.9 4-8.5Z"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/>',
  sync: '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 16"/><path d="M4 20v-4h4"/>',
  pen:  '<path d="M14.5 4.5 19 9 8.5 19.5l-5 1 1-5L14.5 4.5Z"/><path d="M12.5 6.5 17 11"/>',
  briefcase:'<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3M3 13h18"/>',
