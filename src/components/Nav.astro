---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const is = (p: string) =>
  p === '/' ? path === '/' : path.startsWith(p);
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      homo<span class="accent">.</span>
      <small>读书研思</small>
    </a>
    <nav class="nav-links" aria-label="主导航">
      <a href="/" class={is('/') ? 'active' : ''}>首页</a>
      <a href="/features" class={is('/features') || is('/docs') || is('/diary') || is('/surfing') || is('/sites') || is('/word') || is('/books') || is('/milestones') || is('/ledger') || is('/sync') || is('/search') ? 'active' : ''}>功能</a>
      <a href="/blog" class={is('/blog') ? 'active' : ''}>博客</a>
      <a href="/reading" class={is('/reading') ? 'active' : ''}>读书录</a>
      <a href="/about" class={is('/about') ? 'active' : ''}>关于</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
