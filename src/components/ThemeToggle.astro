<button id="theme-toggle" class="icon-btn" type="button" aria-label="切换亮 / 暗主题" title="切换亮 / 暗主题">
  <!-- 月亮：亮色模式下显示（点击切暗） -->
  <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
  </svg>
  <!-- 太阳：暗色模式下显示（点击切亮） -->
  <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none">
    <circle cx="12" cy="12" r="4.5"/>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M19.4 4.6l-1.8 1.8M6.4 17.6l-1.8 1.8"/>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    const moon = document.getElementById('icon-moon');
    const sun = document.getElementById('icon-sun');

    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      moon.style.display = dark ? 'none' : 'block';
      sun.style.display = dark ? 'block' : 'none';
    };
    sync();

    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      sync();
    });
  })();
</script>
