---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';
import { marked } from 'marked';

// 「写在后面」：src/content/pages/about-afterword.md，在 /write「页面」模式编辑
const pageMds = await getCollection('pages').catch(() => []);
const afterDoc = pageMds.find((e) => e.id === 'about-afterword');
const afterHtml = afterDoc ? marked.parse(afterDoc.body ?? '', { gfm: true, breaks: true }) : '';
---

<BaseLayout title={`关于 · ${SITE.title}`} description="关于 homo：历史地理爱好者，高中地理教师，读书研思。">
  <div class="container-narrow" style="padding-top: 3rem;">
    <p class="eyebrow">About</p>
    <div style="display:flex; align-items:center; gap:0.9rem; margin:0.2rem 0 0.4rem;"><svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" style="fill:var(--accent)"/><text x="28" y="37" text-anchor="middle" font-family="Georgia, serif" font-size="26" font-style="italic" style="fill:var(--bg)">h</text></svg><h1 class="page-title" style="margin:0;">关于我</h1></div>

    <p class="lead" style="font-size:1.1rem;">
      我是 <strong>homo</strong>，一名历史地理爱好者。书斋、课堂与四季的天象，是我平日最常驻足的三个地方。
    </p>

    <p style="margin-top: 1rem;">
      读书研思，记录文史、气象与技术的随想——这个站点既是我的随笔本，也是我的个人名片：
      如果你恰好关心同样的问题，欢迎来信交流。
    </p>

    <hr class="rule" />

    <h2 style="font-size:1.2rem; margin-bottom: 1.2rem;">经历</h2>
    <ul class="timeline">
      <li>
        <span class="stage">Academic</span>
        <h3>本科 · 地理学基础</h3>
        <p class="muted">系统接受地理学训练（院校名不公开）。在那几年里，我同时爱上了历史——大约是因为读地图，也离不开读时间。</p>
      </li>
      <li>
        <span class="stage">Now</span>
        <h3>高中地理教师</h3>
        <p class="muted">在课堂上讲城乡、讲气候、讲人如何与这片土地相处；课堂之外，仍旧读书、写随笔、做些小工具。</p>
      </li>
      <li>
        <span class="stage">Practice</span>
        <h3>这个网站</h3>
        <p class="muted">记录文史、气象与技术的随想，兼作个人名片与作品陈列。持续更新中。</p>
      </li>
    </ul>

    <hr class="rule" />

    <h2 style="font-size:1.2rem; margin-bottom: 0.8rem;">关键词</h2>
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
      <span class="tag">高中地理教学</span>
      <span class="tag">历史地理</span>
      <span class="tag">节俗文化</span>
      <span class="tag">气象观测</span>
      <span class="tag">阅读与写作</span>
      <span class="tag">个人知识管理</span>
      <span class="tag">前端小工具</span>
    </div>

    {afterDoc && (
      <>
        <hr class="rule" />
        <h2 style="font-size:1.2rem; margin-bottom: 0.8rem;">写在后面</h2>
        <div class="prose" set:html={afterHtml} />
      </>
    )}

    <hr class="rule" />

    <h2 style="font-size:1.2rem; margin-bottom: 0.8rem;">关于本站 · Colophon</h2>
    <ul class="colophon">
      <li><span>构建</span><p>Astro 7 + Markdown；博客正文：仓库 Markdown（优先）＋ Sanity CMS 兜底；构建时静态生成，发布即生效</p></li>
      <li><span>托管</span><p>GitHub Pages 主站 homozzy.github.io；Vercel 作为实验部署</p></li>
      <li><span>字体</span><p>中文：Noto Serif SC / Songti SC / SimSun；英文与数字：Georgia，配 <code>font-feature-settings: "onum"</code> 旧时代数字</p></li>
      <li><span>配色</span><p>米纸 #faf8f5 · 墨 #292520 · 砖红 #a63f2c；暗色模式对应 #171512 / #e9e4d8 / #d08a5a</p></li>
      <li><span>内容</span><p>52 条读书笔记与创作；627 条原创微博（2015–2026，已去转发/推广）；不收集、不追踪、无广告</p></li>
      <li><span>源码</span><p><a href="https://github.com/homozzy/homozzy.github.io">github.com/homozzy/homozzy.github.io</a>（MIT）</p></li>
      <li><span>订阅</span><p><a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a> · 欢迎来信 {SITE.email}</p></li>
    </ul>

    <hr class="rule" />

    <h2 style="font-size:1.2rem; margin-bottom: 0.8rem;">联系</h2>
    <p class="muted">来信请写明来意，通常会在看到后的几天内回复。</p>
    <p style="margin-top: 0.8rem;">
      <a class="btn" href={`mailto:${SITE.email}`}>✉️ {SITE.email}</a>
    </p>
  </div>
</BaseLayout>
