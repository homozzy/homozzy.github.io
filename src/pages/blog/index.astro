---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { getAllPosts } from '../../lib/sanity';

export const prerender = false;

const posts = await getAllPosts();
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`博客 · ${SITE.title}`} description="文史、气象与技术的随想，读书研思。">
  <div class="container-narrow" style="padding-top: 3rem;">
    <p class="eyebrow">Essays</p>
    <h1 class="page-title">博客<span class="accent">.</span></h1>
    <p class="muted">文史、气象与技术的随想。<a href="/rss.xml" class="accent" style="text-decoration:underline;text-underline-offset:3px;">RSS 订阅</a> · <a href="https://homo-site-studio.sanity.studio" target="_blank" rel="noopener noreferrer" class="btn btn-ghost" style="padding:0.3rem 0.8rem; font-size:0.78rem; vertical-align:middle;">＋ 写新博客</a></p>

    {posts.length === 0 && <p class="muted" style="margin-top:1.5rem;">暂无文章，去 Studio 发布第一篇。</p>}
    <ul class="post-list" style="margin-top: 1.5rem;">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.slug.current}/`}>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
          <div class="meta">
            <time datetime={new Date(post.pubDate).toISOString()}>{fmt(post.pubDate)}</time>
            {(post.tags ?? []).map((t) => <span class="tag">{t}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
