---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import readingNotes from '../data/reading-notes.json';
import { getAllPosts } from '../lib/sanity';

const posts = await getAllPosts();
const latestPost = posts[0] ?? null;

type Note = { id: string; date: string; book: string; text: string };
const latestNote = (readingNotes as Note[]).reduce((a, b) => (a.date > b.date ? a : b));
const fmt = (d: string) => new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <div class="container">

    <section class="cover">
      <div class="cover-main">
        <p class="eyebrow">History · Geography · Essays</p>
        <h1 class="cover-name">homo</h1>
        <p class="cover-tagline">一名历史地理爱好者，<br />读书研思，记录文史、气象与技术的随想。</p>
        <p class="cover-sub">本科 · 现任高中地理教师 · 读书人 / 写字人 / 做小工具的人</p>
        <div class="cover-actions">
          <a class="btn" href="/blog">看博客 →</a>
          <a class="text-link" href="/about">关于我</a>
        </div>
      </div>

      <div class="cover-deco" aria-hidden="true">
        <span class="cover-vertical">读书研思</span>
        <div class="seal seal--cover">研<br />思</div>
      </div>
    </section>

    <hr class="rule rule--cover" />

    <section class="issue-row" aria-label="本期导读">
      <div class="issue-note">
        <p class="eyebrow">Editor's Note · 编者按</p>
        <p class="issue-text">读书最大的好处，不是“知道得多”，而是“想得深”。这个站点既是随笔集，也是我的坐标：记录我教过的每一堂地理课、每一本认真翻过的书，以及每一段在课堂之外继续发生的思考。</p>
        <p class="issue-sub">55 本书 · 52 条笔记 · 627 条微博原帖 · 持续更新</p>
      </div>

      {latestPost && (
        <a class="issue-featured" href={`/blog/${latestPost.slug.current}/`}>
          <p class="eyebrow">Featured · 精选</p>
          <blockquote>「哪有什么“黄金时代”，从来都是勇毅者以自己的名字开创的纪元。」</blockquote>
          <p class="issue-featured-title">{latestPost.title}</p>
          <span class="issue-featured-meta">{fmt(latestPost.pubDate)}</span>
        </a>
      )}
    </section>

    <section class="cover-toc" aria-label="目录">
      <a href="/blog" class="toc-item">
        <span class="toc-label">Blog</span>
        <span class="toc-body">
          {latestPost ? (
            <>
              <strong>{latestPost.title}</strong>
              <span class="toc-meta">{fmt(latestPost.pubDate)}</span>
            </>
          ) : (
            <strong>正在写第一篇……</strong>
          )}
        </span>
      </a>

      <a href="/reading" class="toc-item">
        <span class="toc-label">Reading</span>
        <span class="toc-body">
          <strong>最近在读《{latestNote.book}》</strong>
          <span class="toc-meta">{fmt(latestNote.date)} · {latestNote.book.length > 16 ? '节选两句' : ''}</span>
        </span>
      </a>

      <a href="/features" class="toc-item">
        <span class="toc-label">Archive</span>
        <span class="toc-body">
          <strong>全部功能与旧档</strong>
          <span class="toc-meta">读书录 · 微博归档 · 藏书阁 · 大事记</span>
        </span>
      </a>
    </section>
  </div>
</BaseLayout>

