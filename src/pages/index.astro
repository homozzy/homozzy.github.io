---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';
import readingNotes from '../data/reading-notes.json';

type Note = { id: string; date: string; book: string };
const latestNote = (readingNotes as unknown as Note[]).reduce((a, b) => (a.date > b.date ? a : b));
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <section class="container hero">
    <div>
      <p class="eyebrow">History · Geography · Essays</p>
      <h1>homo</h1>
      <p class="lead">一名历史地理爱好者，读书研思，记录文史、气象与技术的随想。</p>
      <p class="sub">本科 · 现任高中地理教师 · 读书人 / 写字人 / 做小工具的人</p>
      <p class="recent">最近记录 · <a href={`/reading/#note-${latestNote.id}`}>《{latestNote.book}》</a> · {latestNote.date.replaceAll('-', '.')}</p>
      <div class="hero-stats" aria-label="站内统计">
        <div><strong>55</strong><span>本（部）书</span></div>
        <div><strong>52</strong><span>条读书笔记</span></div>
        <div><strong>9</strong><span>个书目分类</span></div>
        <div><strong>1</strong><span>篇成稿随笔</span></div>
      </div>
      <div class="hero-actions">
        <a class="btn" href="/blog">看博客 →</a>
        <a class="btn btn-ghost" href="/about">关于我</a>
        <a class="btn btn-ghost" href="/features">全部功能</a>
      </div>
    </div>

    <div class="hero-deco" aria-hidden="true">
      <span class="vertical-text">读书研思</span>
      <div class="seal">研<br />思</div>
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog">全部文章 <span aria-hidden="true">→</span></a>
    </div>
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}/`}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container" style="margin-top: 2.5rem;">
    <div class="section-head">
      <h2>读书录</h2>
      <a href="/reading">全部笔记 <span aria-hidden="true">→</span></a>
    </div>
    <a href="/reading" class="work-card" style="display:block; text-decoration:none;">
      <span class="eyebrow">Reading Journal · Weibo</span>
      <h3 style="margin-top:0.3rem;">十一年微博读书笔记，原文全录</h3>
      <p class="muted" style="margin-top:0.4rem;">从《物种起源》到《智人之上》，52 条笔记 / 55 本书，文史·科幻·心理与人性。</p>
    </a>
  </section>

  <section class="container" style="margin-top: 2.5rem;">
    <div class="section-head">
      <h2>精选作品</h2>
      <a href="/works">全部作品 <span aria-hidden="true">→</span></a>
    </div>
    <div class="work-grid">
      <article class="work-card">
        <span class="eyebrow">Personal Workbench</span>
        <h3>个人工作台</h3>
        <p class="muted">把读书、教学随手记和常用工具收在一起的自用工作台，细节待补充。</p>
        <a href="/works" class="btn btn-ghost" style="align-self:flex-start; padding:0.4rem 0.9rem;">查看 →</a>
      </article>
    </div>
  </section>
</BaseLayout>
