---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import readingNotes from '../data/reading-notes.json';
import { getAllPosts } from '../lib/sanity';

const posts = await getAllPosts();
const latestPost = posts[0] ?? null;

type Note = { id: string; date: string; book: string; text: string };
const latestNote = (readingNotes as Note[]).reduce((a, b) => (a.date > b.date ? a : b));
const fmt = (d: string) => new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout>
  <div class="container">

    <section class="cover">
      <div class="cover-main">
        <p class="eyebrow">History · Geography · Essays</p>
        <h1 class="cover-name">homo</h1>
        <p class="cover-tagline">一名高中地理教师 × 历史地理爱好者。<br />在课堂上讲季风与人口，在书页里读过去与未来。</p>
        <p class="cover-sub">本科 · 现任高中地理教师 · 读书人 / 写字人 / 做小工具的人</p>
        <div class="cover-actions">
          <a class="btn" href="/blog">看博客 →</a>
          <a class="text-link" href="/about">关于我</a>
        </div>

        <div class="quickwrite" id="quickwrite">
          <button id="qw-open" class="qw-trigger" type="button" aria-expanded="false" aria-controls="qw-form">✍ 随手写一句…</button>
          <div id="qw-form" class="qw-form" hidden>
            <textarea id="qw-body" rows="3" placeholder="第一行是标题，下面是正文……" spellcheck="false"></textarea>
            <div class="qw-row">
              <div class="qw-chips" id="qw-chips" role="group" aria-label="选标签">
                {['随笔', '讲台', '文史', '气象', '技术'].map((t) => (
                  <button type="button" class="qw-chip" data-tag={t} aria-pressed={t === '随笔' ? 'true' : 'false'}>{t}</button>
                ))}
              </div>
              <input id="qw-tags" value="随笔" hidden />
              <button id="qw-send" class="btn" type="button">发布 →</button>
              <span id="qw-status" class="meta-line" style="margin:0;" aria-live="polite" tabindex="-1"></span>
            </div>
            <p class="qw-hint">发布后 1–2 分钟自动上线 · <a href="/write">去完整编辑器</a></p>
          </div>
        </div>
      </div>

      <div class="cover-deco" aria-hidden="true">
        <span class="cover-vertical">读书研思</span>
        <div class="seal seal--cover">研<br />思</div>
      </div>
    </section>

    <hr class="rule rule--cover" />

    <section class="issue-row" aria-label="本期导读">
      <div class="issue-note">
        <p class="eyebrow">Editor's Note · 编者按</p>
        <p class="issue-text">读书最大的好处，不是“知道得多”，而是“想得深”。这个站点既是随笔集，也是我的坐标：记录我教过的每一堂地理课、每一本认真翻过的书，以及每一段在课堂之外继续发生的思考。</p>
        <p class="issue-sub">55 本书 · 52 条笔记 · 627 条微博原帖 · 持续更新</p>
      </div>

      {latestPost && (
        <a class="issue-featured" href={`/blog/${latestPost.slug.current}/`}>
          <p class="eyebrow">Featured · 精选</p>
          <blockquote>「哪有什么“黄金时代”，从来都是勇毅者以自己的名字开创的纪元。」</blockquote>
          <p class="issue-featured-title">{latestPost.title}</p>
          <span class="issue-featured-meta">{fmt(latestPost.pubDate)}</span>
        </a>
      )}
    </section>

    <section class="cover-toc" aria-label="目录">
      <a href="/blog" class="toc-item">
        <span class="toc-label">Blog</span>
        <span class="toc-body">
          {latestPost ? (
            <>
              <strong>{latestPost.title}</strong>
              <span class="toc-meta">{fmt(latestPost.pubDate)}</span>
            </>
          ) : (
            <strong>正在写第一篇……</strong>
          )}
        </span>
      </a>

      <a href="/reading" class="toc-item">
        <span class="toc-label">Reading</span>
        <span class="toc-body">
          <strong>最近在读《{latestNote.book}》</strong>
          <span class="toc-meta">{fmt(latestNote.date)} · {latestNote.book.length > 16 ? '节选两句' : ''}</span>
        </span>
      </a>

      <a href="/features" class="toc-item">
        <span class="toc-label">Archive</span>
        <span class="toc-body">
          <strong>全部功能与旧档</strong>
          <span class="toc-meta">读书录 · 微博归档 · 藏书阁 · 大事记</span>
        </span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .quickwrite { margin-top: 1.3rem; }
  .qw-trigger {
    background: none; border: none; padding: 0; cursor: pointer;
    color: var(--muted); font: inherit; font-size: 0.95rem;
    text-decoration: underline dotted; text-underline-offset: 3px;
  }
  .qw-trigger:hover { color: var(--accent); }
  .qw-form { margin-top: 0.75rem; max-width: 560px; }
  .qw-form textarea {
    width: 100%; box-sizing: border-box; padding: 0.6rem 0.8rem;
    border: 1px solid var(--line); border-radius: 8px;
    background: var(--panel); color: var(--ink);
    font: inherit; font-size: 0.95rem; line-height: 1.7; resize: vertical;
  }
  .qw-row { display: flex; gap: 0.5rem; margin-top: 0.55rem; align-items: center; flex-wrap: wrap; }
  .qw-row input {
    width: 118px; padding: 0.38rem 0.6rem;
    border: 1px solid var(--line); border-radius: 8px;
    background: var(--panel); color: var(--ink); font: inherit; font-size: 0.9rem;
  }
  #qw-send { font-size: 0.9rem; padding: 0.38rem 1rem; }
  .qw-hint { font-size: 0.78rem; margin-top: 0.4rem; color: var(--muted); }
  .qw-chips { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .qw-chip {
    border: 1px solid var(--line); background: var(--panel); color: var(--muted);
    border-radius: 999px; padding: 0.32rem 0.88rem; font: inherit; font-size: 0.85rem;
    cursor: pointer; transition: 0.15s ease;
  }
  .qw-chip:hover { color: var(--accent); border-color: var(--accent); }
  .qw-chip.on {
    background: var(--accent-soft); color: var(--accent);
    border-color: var(--accent); font-weight: 600;
  }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  html[data-theme='dark'] .qw-form textarea,
  html[data-theme='dark'] .qw-row input { border-color: rgba(255,255,255,0.1); }
</style>

<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const openBtn = $('qw-open'), form = $('qw-form');
    if (!openBtn) return;
    const bodyEl = $('qw-body'), tagsEl = $('qw-tags'), status = $('qw-status');
    const PAT_KEY = 'gh-pat';
    const DRAFT_KEY = 'write-draft-v3';
    const REPO = 'homozzy/homozzy.github.io';
    const DIR = 'src/content/blog';

    const saveDraft = () => {
      try {
        const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');
        d.body = bodyEl.value;
        d.tags = tagsEl.value;
        localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
      } catch {}
    };

    openBtn.addEventListener('click', () => {
      const opening = form.hidden;
      form.hidden = !opening;
      openBtn.setAttribute('aria-expanded', opening ? 'true' : 'false');
      if (!form.hidden) {
        openBtn.style.display = 'none';
        try {
          const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');
          if (d.body) bodyEl.value = d.body;
          if (d.tags) tagsEl.value = d.tags;
          syncChips();
        } catch {}
        bodyEl.focus();
      }
    });

    const api = async (url, opts = {}) => {
      const res = await fetch(url, { ...opts, headers: { ...(opts.headers || {}), Authorization: `Bearer ${localStorage.getItem(PAT_KEY) || ''}`, Accept: 'application/vnd.github+json' } });
      if (res.status === 401) throw new Error('钥匙无效或过期，去 /write 重填');
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || '请求失败');
      return data;
    };

    const friendlyErr = (err) => {
      const m = String(err?.message || err || '');
      if (/fetch|network|load failed/i.test(m)) return '网络连接失败，检查网络再试一次';
      if (/unexpected|json/i.test(m)) return 'GitHub 返回了异常内容，稍后再试';
      if (m.startsWith('403')) return '权限不够或请求太频繁（GitHub 限流），等一会儿再试';
      if (m.startsWith('404')) return '仓库或文件不存在';
      if (m.startsWith('422')) return '提交冲突（可能刚发过一次同内容），重试一次即可';
      return m.slice(0, 60) || '未知错误';
    };

    const publish = async () => {
      const send = $('qw-send');
      if (send?.disabled) return;
      const pat = localStorage.getItem(PAT_KEY) || '';
      if (!pat) {
        status.innerHTML = '第一次发布需要一把钥匙 · <a class="accent" href="/write">去 /write 保存一次</a>';
        return;
      }
      const raw = (bodyEl.value || '').replace(/\r\n/g, '\n');
      const first = raw.indexOf('\n');
      const title = (first === -1 ? raw : raw.slice(0, first)).replace(/^#+\s*/, '').trim();
      if (!title) { status.textContent = '第一行当标题写吧'; return; }
      const body = first === -1 ? '' : raw.slice(first + 1).replace(/^\n+/, '');
      const tags = (tagsEl.value || '随笔').split(/[,，]/).map(s => s.trim()).filter(Boolean).map(t => `"${t}"`).join(', ');
      const firstPara = (body.split('\n').find(l => l.trim() && !l.trim().startsWith('#')) || '').trim().slice(0, 60);
      const q = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
      const ascii = title.match(/[A-Za-z][A-Za-z0-9-]{2,}/);
      const now = new Date();
      const slug = ascii ? ascii[0].toLowerCase()
        : 'w' + now.toISOString().slice(0, 10).replace(/-/g, '') + '-' + String(now.getHours()).padStart(2,'0') + String(now.getMinutes()).padStart(2,'0');
      const md = `---\ntitle: "${q(title)}"\ndescription: "${q(firstPara)}"\npubDate: ${now.toISOString().slice(0, 10)}\ntags: [${tags}]\n---\n\n${body}`;
      send.disabled = true;
      status.textContent = '发布中…';
      try {
        const path = `${DIR}/${slug}.md`;
        let sha;
        try { sha = (await api(`https://api.github.com/repos/${REPO}/contents/${path}`)).sha; } catch {}
        await api(`https://api.github.com/repos/${REPO}/contents/${path}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: `blog: ${title}`, content: btoa(unescape(encodeURIComponent(md))), ...(sha ? { sha } : {}) }),
        });
        status.innerHTML = `✅ 已发布 <a class="accent" href="/blog/${slug}/">去文章页</a>`;
        bodyEl.value = '';
        saveDraft();
        status.focus();
      } catch (err) {
        status.textContent = friendlyErr(err);
      } finally {
        send.disabled = false;
      }
    };

    $('qw-send').addEventListener('click', publish);

    // 标签块：点击切换（多选），实际值存在隐藏的 #qw-tags 里
    const chipBox = $('qw-chips');
    const syncChips = () => {
      const val = tagsEl.value;
      for (const c of chipBox.querySelectorAll('.qw-chip')) {
        const on = (' ' + val + ' ').includes(` ${c.dataset.tag} `);
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    };
    const setTags = (list) => { tagsEl.value = list.join(', '); syncChips(); saveDraft(); };
    chipBox.addEventListener('click', (e) => {
      const c = e.target?.closest?.('.qw-chip');
      if (!c) return;
      const cur = tagsEl.value.split(/[,，]/).map(s => s.trim()).filter(Boolean);
      setTags(cur.includes(c.dataset.tag) ? cur.filter(t => t !== c.dataset.tag) : [...cur, c.dataset.tag]);
    });
    syncChips();
    bodyEl.addEventListener('input', saveDraft);
    tagsEl.addEventListener('input', saveDraft);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !form.hidden) {
        form.hidden = true;
        openBtn.style.display = '';
        openBtn.setAttribute('aria-expanded', 'false');
        openBtn.textContent = '✍ 随手写一句…';
        openBtn.focus();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !form.hidden) publish();
    });
  })();
</script>

