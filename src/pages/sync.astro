---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`数据同步 · ${SITE.title}`} description="账本等本地数据的备份与恢复。">
  <div class="container-narrow" style="padding-top: 3rem;">
    <p class="eyebrow">Backup & Restore</p>
    <h1 class="page-title">数据同步<span class="accent">.</span></h1>
    <p class="muted">本站的数据只存在你这台浏览器里（localStorage），没有服务器、没有账号、没人能看见。代价是：换设备或清缓存，数据就没了。</p>

    <h2 class="block-title">会备份什么</h2>
    <div class="extra-grid">
      <div class="extra-item"><span class="extra-cat">账本</span><span>全部流水记录（ledger-entries-v1）</span></div>
    </div>
    <p class="muted" style="font-size:0.8rem; margin-top:0.5rem;">备份文件为 JSON，文件名形如 <code>homo-backup-2026-11-03.json</code>。明文可读，别发给别人。</p>

    <h2 class="block-title">导出备份</h2>
    <p class="muted" style="font-size:0.9rem;">把上面那些数据打包下载到本机。建议一个月导一次。</p>
    <button id="btn-export" class="btn" type="button" style="margin-top:0.6rem;">⬇ 导出备份文件</button>

    <h2 class="block-title">导入恢复</h2>
    <p class="muted" style="font-size:0.9rem;">从备份文件恢复。<strong>替换</strong>会覆盖本机现有账本；<strong>合并</strong>会按 id 去重后相加。</p>
    <div style="display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:0.6rem;">
      <label class="btn btn-ghost" style="cursor:pointer;">选择备份文件…
        <input id="file-import" type="file" accept="application/json" hidden />
      </label>
      <button id="btn-replace" class="btn btn-ghost" type="button">替换本机数据</button>
      <button id="btn-merge" class="btn btn-ghost" type="button">合并备份数据</button>
    </div>
    <p id="import-msg" class="meta-line" aria-live="polite"></p>

    <h2 class="block-title" style="color:#b0413e;">危险区</h2>
    <p class="muted" style="font-size:0.9rem;">只清本机数据，不可恢复。先导出备份再动手。</p>
    <button id="btn-delete" class="btn-danger" type="button" style="margin-top:0.4rem;">清空本机账本数据</button>

    <p class="muted" style="font-size:0.75rem; margin-top:1.6rem;">
      备份中不包含：网站源码（在 <a class="accent" href="https://github.com/homozzy/homozzy.github.io">GitHub 仓库</a>）、微博原文（在微博）。
    </p>
  </div>

  <script is:inline>
    (() => {
      const KEY = 'ledger-entries-v1';
      const $ = (id) => document.getElementById(id);
      const download = (name, text) => {
        const blob = new Blob([text], { type: 'application/json' });
        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: name });
        a.click();
        URL.revokeObjectURL(a.href);
      };
      $('btn-export')?.addEventListener('click', () => {
        const data = {
          version: 1,
          exportedAt: new Date().toISOString(),
          ledger: JSON.parse(localStorage.getItem(KEY) || '[]'),
        };
        download(`homo-backup-${new Date().toISOString().slice(0, 10)}.json`, JSON.stringify(data, null, 2));
        $('import-msg').textContent = `已导出备份文件（${data.ledger.length} 笔）。`;
      });

      let pending = null;
      $('file-import')?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        file.text().then((text) => {
          try {
            pending = JSON.parse(text);
            if (!pending || !Array.isArray(pending.ledger)) throw new Error('格式不对');
            $('import-msg').textContent = `已读取备份（${pending.ledger.length} 笔，导出时间 ${pending.exportedAt || '未知'}）。选择"替换"或"合并"。`;
          } catch {
            pending = null;
            $('import-msg').textContent = '这个文件不是我的备份格式。';
          }
        });
      });

      $('btn-replace')?.addEventListener('click', () => {
        if (!pending) { $('import-msg').textContent = '先选择备份文件。'; return; }
        localStorage.setItem(KEY, JSON.stringify(pending.ledger));
        $('import-msg').textContent = `已替换本机账本（${pending.ledger.length} 笔）。`;
      });
      $('btn-merge')?.addEventListener('click', () => {
        if (!pending) { $('import-msg').textContent = '先选择备份文件。'; return; }
        const cur = JSON.parse(localStorage.getItem(KEY) || '[]');
        const ids = new Set(cur.map(r => r.id));
        const merged = [...cur, ...pending.ledger.filter(r => !ids.has(r.id))];
        localStorage.setItem(KEY, JSON.stringify(merged));
        $('import-msg').textContent = `已合并，共 ${merged.length} 笔。`;
      });
      $('btn-delete')?.addEventListener('click', () => {
        if (confirm('确定清空本机账本数据？此操作不可恢复。')) {
          localStorage.removeItem(KEY);
          $('import-msg').textContent = '已清空本机账本数据。';
        }
      });
    })();
  </script>
</BaseLayout>
