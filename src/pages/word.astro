---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { WORDS } from '../data/words';
import { MILESTONES } from '../data/milestones';

const dayIndex = Math.floor(Date.now() / 86400000);
const todayPair = MILESTONES[dayIndex % MILESTONES.length];
---

<BaseLayout title={`日进一词 · ${SITE.title}`} description="每天一枚成语，附释义与出处。">
  <div class="container-narrow" style="padding-top: 3rem;">
    <p class="eyebrow">One Word a Day</p>
    <h1 class="page-title">日进一词<span class="accent">.</span></h1>
    <p class="muted">每天一枚成语。同一天看到的是同一枚；明天，下一枚。</p>

    <div class="word-display" style="margin-top: 1.4rem;">
      <div class="word" id="w-word"></div>
      <div class="pinyin" id="w-pinyin"></div>
      <p class="meaning" id="w-meaning"></p>
      <p class="source" id="w-source"></p>
      <p class="source" id="w-index" style="margin-top:0.3rem;"></p>
    </div>

    <div class="word-nav">
      <button class="btn btn-ghost btn-sm" id="w-prev" type="button">← 上一枚</button>
      <button class="btn btn-ghost btn-sm" id="w-today" type="button">回到今天</button>
      <button class="btn btn-ghost btn-sm" id="w-next" type="button">下一枚 →</button>
    </div>

    <a href={`/milestones#${todayPair.id}`} class="word-pair" aria-label={`今日此刻：${todayPair.title}，查看大事记`}>
      <span class="eyebrow">今日 × 此刻</span>
      <span class="word-pair-year">{todayPair.year}</span>
      <strong class="word-pair-title">{todayPair.title}</strong>
      <span class="word-pair-body">{todayPair.body}</span>
      <span class="word-pair-cta">去大事记 →</span>
    </a>
  </div>

  <script type="application/json" id="word-data" is:inline set:html={JSON.stringify(WORDS)}></script>
  <script is:inline>
    (() => {
      const WORDS = JSON.parse(document.getElementById('word-data').textContent);
      const dayIndex = () => Math.floor(Date.now() / 86400000);
      let offset = 0;
      const el = {
        word: document.getElementById('w-word'),
        pinyin: document.getElementById('w-pinyin'),
        meaning: document.getElementById('w-meaning'),
        source: document.getElementById('w-source'),
        index: document.getElementById('w-index'),
      };
      const render = () => {
        const i = ((dayIndex() + offset) % WORDS.length + WORDS.length) % WORDS.length;
        const w = WORDS[i];
        el.word.textContent = w.word;
        el.pinyin.textContent = w.pinyin;
        el.meaning.textContent = w.meaning;
        el.source.textContent = w.source;
        el.index.textContent = `第 ${i + 1} / ${WORDS.length} 枚 · ${offset === 0 ? '今天' : offset > 0 ? `后 ${offset} 天` : `前 ${-offset} 天`}`;
      };
      document.getElementById('w-prev')?.addEventListener('click', () => { offset--; render(); });
      document.getElementById('w-next')?.addEventListener('click', () => { offset++; render(); });
      document.getElementById('w-today')?.addEventListener('click', () => { offset = 0; render(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { offset--; render(); }
        else if (e.key === 'ArrowRight') { offset++; render(); }
      });
      render();
    })();
  </script>
</BaseLayout>
