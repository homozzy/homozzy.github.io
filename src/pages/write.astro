---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`写一篇 · ${SITE.title}`} description="一句话发布：第一行是标题，其余全是正文，点发布 1–2 分钟后自动上线。">
  <div class="container-narrow" style="padding-top: 2.5rem;">
    <p class="eyebrow">Write</p>
    <h1 class="page-title">写一篇<span class="accent">.</span></h1>
    <p class="muted">规则很简单：<strong>第一行是标题，其余全是正文</strong>。草稿自动存本机。发布后 1–2 分钟自动上线。</p>

    <div id="pat-block" class="write-auth" style="display:none;">
      <input id="w-pat" class="input" type="password" placeholder="GitHub PAT（只需第一次）" autocomplete="off" />
      <button id="btn-load" class="btn btn-ghost" type="button">保存钥匙</button>
    </div>
    <div id="pat-ok" class="meta-line" style="display:none;">
      钥匙已保存在本机浏览器 · <button id="btn-forget" class="btn-link" type="button">清除</button>
    </div>

    <div class="target-row" style="margin-top:1.1rem;">
      <label class="field" style="margin:0;">
        <span class="label">写在哪</span>
        <select id="w-target" class="input" style="width:auto;" autocomplete="off">
          <option value="blog">博客 · 新文章</option>
          <optgroup label="页面模块（各自独立一块）">
            <option value="now-teaching">此刻 · 正在教</option>
            <option value="now-reading">此刻 · 正在读</option>
            <option value="now-writing">此刻 · 正在写</option>
            <option value="now-site">此刻 · 这个站</option>
            <option value="about-afterword">关于我 · 写在后面</option>
            <option value="works-log">作品 · 进行中的记录</option>
            <option value="monsoon-notes">季风演示 · 备课随记</option>
            <option value="podium-intro">讲台 · 栏目导语</option>
          </optgroup>
        </select>
      </label>
      <span id="target-hint" class="meta-line"></span>
    </div>

    <label class="field" style="margin-top:1rem;">
      <span class="label" id="body-label">想写的都在这里（第一行 = 标题）</span>
      <textarea id="w-body" class="input mono" rows="16"
        placeholder="课例：一张地图引发的争论&#10;&#10;这节课我想让学生自己看图说话，结果争论比预想的激烈的多……&#10;&#10;（支持 Markdown：## 小节、**加粗**、列表都行）"
        spellcheck="false"></textarea>
    </label>

    <div class="tag-row">
      <div class="w-chips" id="w-chips" role="group" aria-label="选标签">
        {['随笔', '讲台', '文史', '气象', '技术'].map((t) => (
          <button type="button" class="w-chip" data-tag={t} aria-pressed={t === '随笔' ? 'true' : 'false'}>{t}</button>
        ))}
      </div>
      <input id="w-tags" value="随笔" hidden />
      <button id="btn-save" class="btn" type="button">发布 →</button>
      <span id="w-status" class="meta-line" style="margin:0;" aria-live="polite" tabindex="-1"></span>
    </div>

    <div id="edit-state" class="edit-state" style="display:none;" aria-live="polite">
      正在编辑 <code id="edit-file"></code>
      <button id="btn-fresh" class="btn-link" type="button">新开一篇（另存新文件）</button>
    </div>

    <details id="preview-box" class="write-detail" style="margin-top:1.2rem;">
      <summary class="muted">预览结果</summary>
      <div id="preview-body" class="prose write-preview-body"></div>
    </details>

    <details id="list-box" class="write-detail">
      <summary class="muted">已有文章（点开可继续编辑）<span id="list-count"></span></summary>
      <ul id="post-list"></ul>
    </details>
  </div>

  <script>
    import { marked } from 'marked';

    const $ = (id) => document.getElementById(id);
    const patBlock = $('pat-block');
    const patOk = $('pat-ok');
    const patEl = $('w-pat');
    const bodyEl = $('w-body');
    const tagsEl = $('w-tags');
    const previewBox = $('preview-box');
    const preview = $('preview-body');
    const status = $('w-status');
    const postList = $('post-list');
    const listBox = $('list-box');
    const DRAFT_KEY = 'write-draft-v3';
    const PAT_KEY = 'gh-pat';
    const REPO = 'homozzy/homozzy.github.io';
    const DIR_BLOG = 'src/content/blog';
    const DIR_PAGES = 'src/content/pages';
    const MODULES = {
      'now-teaching': '此刻 · 正在教',
      'now-reading': '此刻 · 正在读',
      'now-writing': '此刻 · 正在写',
      'now-site': '此刻 · 这个站',
      'about-afterword': '关于我 · 写在后面',
      'works-log': '作品 · 进行中的记录',
      'monsoon-notes': '季风演示 · 备课随记',
      'podium-intro': '讲台 · 栏目导语',
    };
    const targetEl = $('w-target');
    const targetHint = $('target-hint');
    const bodyLabel = $('body-label');
    const isPageMode = () => targetEl.value !== 'blog';
    const currentDir = () => (isPageMode() ? DIR_PAGES : DIR_BLOG);

    // 「编辑中」状态：载入已有文章后记住文件名 / 原始日期，重发即覆盖
    let editingFile = '';
    let editingDate = '';

    const editState = $('edit-state');
    const refreshEditState = () => {
      editState.style.display = editingFile ? '' : 'none';
      $('edit-file').textContent = isPageMode()
        ? (MODULES[editingFile.replace(/\.md$/, '')] || editingFile)
        : editingFile;
    };

    const getPAT = () => localStorage.getItem(PAT_KEY) || '';
    const friendlyErr = (err) => {
      const m = String(err?.message || err || '');
      if (/fetch|network|load failed/i.test(m)) return '网络连接失败，检查网络再试一次';
      if (/unexpected|json/i.test(m)) return 'GitHub 返回了异常内容，稍后再试';
      if (m.startsWith('403') || m.includes('rate limit') || m.includes('Forbidden')) return '权限不够或请求太频繁（GitHub 限流），等一会儿再试';
      if (m.startsWith('404') || m.includes('Not Found')) return '仓库或文件不存在（刚发布的内容要等 2 分钟构建）';
      if (m.startsWith('422')) return '提交冲突（GitHub 还没记下上一笔），重试一次即可';
      return m.slice(0, 60) || '未知错误';
    };
    const api = async (url, opts = {}) => {
      let res;
      try { res = await fetch(url, { ...opts, headers: { ...(opts.headers || {}), Authorization: `Bearer ${getPAT()}`, Accept: 'application/vnd.github+json' } }); }
      catch { throw new Error('网络连接失败，检查网络再试一次'); }
      if (res.status === 401) throw new Error('钥匙无效或已过期，点下方"清除"重新填');
      let data;
      try { data = await res.json(); } catch { throw new Error('GitHub 返回了异常内容，稍后再试'); }
      if (!res.ok) throw new Error(`${res.status} ${data.message || '请求失败'}`);
      return data;
    };

    const splitInput = () => {
      const raw = (bodyEl.value || '').replace(/\r\n/g, '\n');
      const firstBreak = raw.indexOf('\n');
      const title = (firstBreak === -1 ? raw : raw.slice(0, firstBreak)).replace(/^#+\s*/, '').trim();
      const rest = firstBreak === -1 ? '' : raw.slice(firstBreak + 1).replace(/^\n+/, '');
      return { title, body: rest };
    };

    const dateStr = () => editingDate || new Date().toISOString().slice(0, 10);

    const makeSlug = (title) => {
      const ascii = title.match(/[A-Za-z][A-Za-z0-9-]{2,}/);
      if (ascii) return ascii[0].toLowerCase();
      const now = new Date();
      return 'w' + now.toISOString().slice(0, 10).replace(/-/g, '') + '-' +
        String(now.getHours()).padStart(2, '0') + String(now.getMinutes()).padStart(2, '0');
    };

    const buildBlogMarkdown = () => {
      const { title, body } = splitInput();
      const tags = (tagsEl.value || '').split(/[,，]/).map(s => s.trim()).filter(Boolean).map(t => `"${t}"`).join(', ');
      const firstPara = (body.split('\n').find(l => l.trim() && !l.trim().startsWith('#')) || '').trim().slice(0, 60);
      const q = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
      return `---\ntitle: "${q(title)}"\ndescription: "${q(firstPara)}"\npubDate: ${dateStr()}\ntags: [${tags}]\n---\n\n${body}`;
    };

    const buildPageMarkdown = (moduleId) => {
      const q = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
      return `---\ntitle: "${q(MODULES[moduleId])}"\ndescription: "页面模块"\npubDate: ${new Date().toISOString().slice(0, 10)}\ntags: []\n---\n\n${bodyEl.value.trim()}`;
    };

    const renderPreview = () => {
      const { title, body } = splitInput();
      if (isPageMode()) {
        preview.innerHTML = marked.parse(bodyEl.value.trim() || '*（空白。写点什么存进来）*', { breaks: true, gfm: true });
        return;
      }
      preview.innerHTML = marked.parse((title ? `# ${title}\n\n` : '') + (body || '*（换个想法就会出现在这里）*'), { breaks: true, gfm: true });
    };

    const saveDraft = () => {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({ target: targetEl.value, body: bodyEl.value, tags: tagsEl.value, file: editingFile, date: editingDate }));
    };

    // 「写在哪」切换时按目标分桶保存正文：博客草稿不会误灌进页面模块，反之亦然
    const BODIES_KEY = 'write-draft-bodies';
    const loadBodies = () => { try { return JSON.parse(localStorage.getItem(BODIES_KEY) || '{}'); } catch { return {}; } };
    const saveBodies = (m) => { try { localStorage.setItem(BODIES_KEY, JSON.stringify(m)); } catch {} };
    let currentTarget = targetEl.value;

    // 「写在哪」模式 UI：标题行文案、标签块显隐、提示
    const btnFresh = $('btn-fresh');
    const chipRow = $('w-chips');
    const applyTargetUI = () => {
      const pageMode = isPageMode();
      targetHint.textContent = pageMode ? '这一块会替换页面里对应模块，发布后 1–2 分钟重渲染' : '第一行是标题，其余是正文';
      bodyLabel.textContent = pageMode ? `「${MODULES[targetEl.value]}」模块` : '想写的都在这里（第一行 = 标题）';
      chipRow.style.display = pageMode ? 'none' : '';
      chipRow.parentElement.querySelector('input#w-tags').style.display = pageMode ? 'none' : '';
      btnFresh.style.display = pageMode ? 'none' : '';
      bodyEl.placeholder = pageMode
        ? '这里写模块正文……支持 Markdown：**加粗**、列表、## 小节都行'
        : '第一行：文章标题（下面空一行开始写正文）……';
    };
    targetEl.addEventListener('change', () => {
      const bodies = loadBodies();
      if (currentTarget !== targetEl.value) {
        bodies[currentTarget] = bodyEl.value;
        currentTarget = targetEl.value;
        bodyEl.value = typeof bodies[currentTarget] === 'string' ? bodies[currentTarget] : '';
        saveBodies(bodies);
      }
      editingFile = ''; editingDate = '';
      refreshEditState();
      applyTargetUI();
      loadList(true);
      renderPreview();
      saveDraft();
    });

    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    /* frontmatter 解析贵在只写一次：列表和载入共用 */
    const parseFront = (raw) => {
      const m = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
      if (!m) return null;
      const fm = m[1], body = m[2];
      const pick = (k) => (fm.split('\n').find(l => l.startsWith(k + ':')) || '').slice(k.length + 1).trim().replace(/^"|"$/g, '');
      const pickArray = (k) => {
        const r = (fm.split('\n').find(l => l.startsWith(k + ':')) || '').slice(k.length + 1).trim().match(/^\[(.*)\]$/);
        return r ? r[1].split(',').map(s => s.trim().replace(/^"|"$/g, '')).filter(Boolean) : [];
      };
      return { fm, body, pick, pickArray };
    };
    const fileSha = new Map(); // 列表时顺手记下 sha，删除时省一次请求

    const loadList = async (silent = false) => {
      const pat = getPAT();
      if (!pat) return;
      try {
        const dir = currentDir();
        const items = await api(`https://api.github.com/repos/${REPO}/contents/${dir}`);
        const mds = items.filter(i => i.name.endsWith('.md'));
        fileSha.clear();
        mds.forEach(i => fileSha.set(i.name, i.sha));
        const isPage = isPageMode();
        /* 博客模式下逐篇抓标题与标签（文章不多，代价可接受）：
           用户认得出「地理 · 讲台」，而不是背文件编号 w20261108-1838 */
        const extra = {};
        if (!isPage) {
          await Promise.all(mds.map(async (i) => {
            try {
              const it = await api(`https://api.github.com/repos/${REPO}/contents/${dir}/${i.name}`);
              const p = parseFront(decodeURIComponent(escape(atob(it.content))));
              extra[i.name] = p ? { title: p.pick('title') || i.name, tags: p.pickArray('tags') } : { title: i.name, tags: [] };
            } catch { extra[i.name] = { title: i.name, tags: [] }; }
          }));
        }
        postList.innerHTML = mds
          .map(i => {
            const id = i.name.replace(/\.md$/, '');
            const meta = extra[i.name];
            const label = isPage ? (MODULES[id] || id) : (meta?.title || id);
            const tags = meta?.tags?.length ? `<span class="li-tags">${esc(meta.tags.join(' / '))}</span>` : '';
            const file = `<span class="li-file">${i.name}</span>`;
            return `<li class="li-row"><button class="post-item-btn" data-name="${i.name}" type="button"><strong>${esc(label)}</strong>${tags}${file}</button><button class="post-item-del" data-del="${i.name}" type="button" title="从仓库删除这篇（构建后文章页消失）">删</button></li>`;
          })
          .join('') || (isPage
            ? '<li class="muted" style="padding:0.4rem 0;">各模块还未写过内容——选中上方模块直接写，发布即建块</li>'
            : '<li class="muted" style="padding:0.4rem 0;">仓库里还没有文章</li>');
        $('list-count').textContent = mds.length ? `（${mds.length}）` : '';
        if (!silent) status.textContent = `读取到 ${mds.length} 块`;
      } catch (err) {
        if (!postList.innerHTML || postList.innerHTML.includes('还没有')) {
          status.textContent = '文章列表加载失败：' + friendlyErr(err);
        }
      }
    };

    const loadPostFile = async (name) => {
      const dir = currentDir();
      try {
        const item = await api(`https://api.github.com/repos/${REPO}/contents/${dir}/${name}`);
        const raw = decodeURIComponent(escape(atob(item.content)));
        const p = parseFront(raw);
        if (!p) { status.textContent = '文件格式无法解析'; return false; }
        editingFile = name;
        editingDate = p.pick('pubDate').slice(0, 10) || dateStr();
        if (isPageMode()) {
          tagsEl.value = '随笔';
          bodyEl.value = p.body.trim();
        } else {
          tagsEl.value = p.pickArray('tags').join(', ') || '随笔';
          bodyEl.value = `${p.pick('title')}\n\n${p.body}`;
        }
        syncChips();
        renderPreview();
        saveDraft();
        refreshEditState();
        status.textContent = isPageMode()
          ? `已载入「${MODULES[name.replace(/\.md$/, '')] || name}」，改完再点发布即覆盖`
          : `已载入「${p.pick('title') || name}」，改完再点发布即覆盖原文`;
        return true;
      } catch (err) {
        status.textContent = friendlyErr(err);
        return false;
      }
    };

    postList.addEventListener('click', async (e) => {
      const del = e.target?.closest?.('.post-item-del');
      if (del) {
        const name = del.dataset.del;
        if (!confirm(`确定删除「${name}」？删除后这篇会从站点消失，不可撤销。`)) return;
        try {
          const dir = currentDir();
          const sha = fileSha.get(name) || (await api(`https://api.github.com/repos/${REPO}/contents/${dir}/${name}`)).sha;
          status.textContent = '删除中…';
          await api(`https://api.github.com/repos/${REPO}/contents/${dir}/${name}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: `write: 删除 ${name}`, sha }),
          });
          if (editingFile === name) { editingFile = ''; editingDate = ''; refreshEditState(); }
          status.textContent = `✅ 已删除 ${name}（最多 2 分钟后生效）`;
          await loadList(true);
        } catch (err) {
          status.textContent = '删除失败：' + friendlyErr(err);
        }
        return;
      }
      const btn = e.target?.closest?.('.post-item-btn');
      if (!btn) return;
      await loadPostFile(btn.dataset.name);
      listBox.open = true;
    });

    bodyEl.addEventListener('input', () => { renderPreview(); saveDraft(); });
    tagsEl.addEventListener('input', saveDraft);

    // 标签块：点击切换（多选），实际值存在隐藏的 #w-tags 里
    const chipBox = $('w-chips');
    const syncChips = () => {
      const val = tagsEl.value;
      for (const c of chipBox.querySelectorAll('.w-chip')) {
        const on = (' ' + val + ' ').includes(` ${c.dataset.tag} `);
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    };
    chipBox.addEventListener('click', (e) => {
      const c = e.target?.closest?.('.w-chip');
      if (!c) return;
      const cur = tagsEl.value.split(/[,，]/).map(s => s.trim()).filter(Boolean);
      tagsEl.value = cur.includes(c.dataset.tag) ? cur.filter(t => t !== c.dataset.tag).join(', ') : [...cur, c.dataset.tag].join(', ');
      syncChips(); saveDraft();
    });
    syncChips();

    $('btn-fresh')?.addEventListener('click', () => {
      editingFile = ''; editingDate = '';
      bodyEl.value = ''; tagsEl.value = '随笔';
      try {
        const bodies = loadBodies();
        delete bodies[currentTarget];
        saveBodies(bodies);
      } catch {}
      renderPreview(); saveDraft(); refreshEditState(); syncChips();
      status.textContent = '新的一篇，开写';
      bodyEl.focus();
    });

    $('btn-save')?.addEventListener('click', async () => {
      const btn = $('btn-save');
      if (btn.disabled) return;
      const pageMode = isPageMode();
      const moduleId = targetEl.value;
      const { title } = pageMode ? { title: MODULES[moduleId] } : splitInput();
      if (pageMode && !bodyEl.value.trim()) { status.textContent = '这个模块还是空的'; return; }
      if (!pageMode && !title) { status.textContent = '第一行得是标题'; return; }
      btn.disabled = true;
      const slug = editingFile ? editingFile.replace(/\.md$/, '') : (pageMode ? moduleId : makeSlug(title));
      const path = `${currentDir()}/${slug}.md`;
      status.textContent = '发布中…';
      try {
        let sha;
        try { sha = (await api(`https://api.github.com/repos/${REPO}/contents/${path}`)).sha; } catch {}
        const md = pageMode ? buildPageMarkdown(moduleId) : buildBlogMarkdown();
        await api(`https://api.github.com/repos/${REPO}/contents/${path}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: pageMode ? `page: ${title}` : `blog: ${title}`, content: btoa(unescape(encodeURIComponent(md))), ...(sha ? { sha } : {}) }),
        });
        const firstPublish = !editingFile;
        editingFile = `${slug}.md`;
        if (!editingDate) editingDate = dateStr();
        saveDraft(); refreshEditState();
        if (pageMode) {
          status.innerHTML = `✅ 已更新「${title}」模块 · 最多 2 分钟后页面重渲染`;
        } else {
          status.innerHTML = `✅ 已发布 <a class="accent" href="/blog/${slug}/">去文章页</a>（最多 2 分钟后生效）${firstPublish ? ' · 写完结了想再发新的，点下方「新开一篇」' : ''}`;
          listBox.open = true;
        }
        await loadList(true);
      } catch (err) {
        status.textContent = friendlyErr(err);
        status.focus();
      } finally {
        btn.disabled = false;
      }
    });

    $('btn-load')?.addEventListener('click', async () => {
      const pat = patEl.value.trim();
      if (!pat) { status.textContent = '先粘贴钥匙'; return; }
      localStorage.setItem(PAT_KEY, pat);
      patBlock.style.display = 'none'; patOk.style.display = '';
      await loadList();
      /* 带 ?edit= 进来但当时没钥匙的：钥匙存好立刻补载入 */
      if (pendingEdit) { const ok = await loadPostFile(pendingEdit); if (ok) { listBox.open = true; bodyEl.focus(); } }
    });
    $('btn-forget')?.addEventListener('click', () => {
      localStorage.removeItem(PAT_KEY);
      patOk.style.display = 'none'; patBlock.style.display = '';
      postList.innerHTML = ''; $('list-count').textContent = '';
    });

    // 初始化
    try {
      const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || '{}');
      if (d.target) targetEl.value = d.target;
      currentTarget = targetEl.value;
      bodyEl.value = d.body ?? '';
      tagsEl.value = d.tags ?? '随笔';
      editingFile = d.file ?? '';
      editingDate = d.date ?? '';
      const bodies = loadBodies();
      if (typeof bodies[targetEl.value] === 'string') bodyEl.value = bodies[targetEl.value];
    } catch {}

    /* ?edit=w20261108-1838.md —— 文章页「✎ 编辑这篇」跳过来时自动载入那篇 */
    const editParam = (new URLSearchParams(location.search).get('edit') || '').trim();
    const pendingEdit = editParam ? (editParam.endsWith('.md') ? editParam : editParam + '.md') : '';
    if (pendingEdit) targetEl.value = 'blog';

    applyTargetUI();
    refreshEditState();
    if (getPAT()) {
      patOk.style.display = '';
      (async () => {
        await loadList(true);
        if (pendingEdit) {
          const ok = await loadPostFile(pendingEdit);
          if (ok) { listBox.open = true; bodyEl.focus(); }
        }
      })();
    } else {
      patBlock.style.display = '';
      if (pendingEdit) status.textContent = `要编辑「${pendingEdit}」：粘贴 GitHub 钥匙并保存，会自动载入这篇`;
    }
    renderPreview();
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        if (document.activeElement === patEl) return;
        $('btn-save').click();
      }
    });
  </script>
</BaseLayout>

