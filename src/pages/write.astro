---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`写新博客 · ${SITE.title}`} description="直接在网站里写文章、保存、发布。">
  <div class="container" style="padding-top: 2.5rem;">
    <p class="eyebrow">Write</p>
    <h1 class="page-title">写新博客<span class="accent">.</span></h1>
    <p class="muted">直接在本站写，点发布立即生效。密钥只保存在你的浏览器。</p>

    <div class="write-auth">
      <input id="w-key" class="input" type="password" placeholder="我的写作密钥" autocomplete="off" />
      <button id="btn-load" class="btn btn-ghost" type="button">加载文章</button>
      <span id="w-auth-status" class="meta-line" aria-live="polite" style="margin:0;"></span>
    </div>

    <div class="write-layout">
      <section class="write-list" aria-label="文章列表">
        <button id="btn-new" class="btn" type="button" style="width:100%; margin-bottom:0.6rem;">＋ 新建文章</button>
        <ul id="post-list"></ul>
      </section>

      <section class="write-form" aria-label="编辑器">
        <div class="form-grid">
          <label class="field"><span class="label">标题</span><input id="w-title" class="input" type="text" placeholder="文章标题" autocomplete="off" /></label>
          <label class="field"><span class="label">日期</span><input id="w-date" class="input" type="date" /></label>
        </div>
        <div class="form-grid">
          <label class="field"><span class="label">文件名（slug，可留空）</span><input id="w-slug" class="input" type="text" placeholder="cyang-yuanxilai" autocomplete="off" /></label>
          <label class="field"><span class="label">标签，逗号分隔</span><input id="w-tags" class="input" type="text" placeholder="文史, 随想" autocomplete="off" /></label>
        </div>
        <label class="field"><span class="label">摘要</span><input id="w-desc" class="input" type="text" placeholder="一句话说清这篇写什么" autocomplete="off" /></label>
        <label class="field"><span class="label">正文（Markdown）</span>
          <textarea id="w-body" class="input mono" rows="14" placeholder="开始写……&#10;&#10;## 小节&#10;&#10;正文段落。" spellcheck="false"></textarea>
        </label>

        <div style="display:flex; gap:0.6rem; flex-wrap:wrap; margin-top:0.4rem;">
          <button id="btn-save" class="btn" type="button">发布</button>
          <button id="btn-delete" class="btn-danger btn-sm" type="button">删除</button>
          <span id="w-status" class="meta-line" aria-live="polite" style="margin:0;"></span>
        </div>
      </section>

      <section class="write-preview" aria-label="预览">
        <div class="preview-head">
          <span class="eyebrow">Preview</span>
          <span id="preview-wordcount" class="muted" style="font-size:0.78rem;"></span>
        </div>
        <div id="preview-body" class="prose write-preview-body"></div>
      </section>
    </div>
  </div>

  <script>
    import { marked } from 'marked';

    const $ = (id) => document.getElementById(id);
    const keyEl = $('w-key');
    const authStatus = $('w-auth-status');
    const postList = $('post-list');
    const titleEl = $('w-title');
    const dateEl = $('w-date');
    const slugEl = $('w-slug');
    const tagsEl = $('w-tags');
    const descEl = $('w-desc');
    const bodyEl = $('w-body');
    const preview = $('preview-body');
    const wordcount = $('preview-wordcount');
    const status = $('w-status');
    const STORAGE_KEY = 'write-key';
    let selectedId = null;
    let posts = [];

    // basic elements
    dateEl.value = new Date().toISOString().slice(0, 10);

    const getKey = () => localStorage.getItem(STORAGE_KEY) || '';
    const setKey = (k) => localStorage.setItem(STORAGE_KEY, k);
    const clearForm = () => {
      selectedId = null;
      [titleEl, slugEl, tagsEl, descEl, bodyEl].forEach(el => (el.value = ''));
      dateEl.value = new Date().toISOString().slice(0, 10);
      renderPreview();
    };
    const fillForm = (p) => {
      selectedId = p._id;
      titleEl.value = p.title;
      slugEl.value = p.slug?.current ?? '';
      dateEl.value = p.pubDate ? p.pubDate.slice(0, 10) : new Date().toISOString().slice(0, 10);
      tagsEl.value = (p.tags ?? []).join(', ');
      descEl.value = p.description ?? '';
      bodyEl.value = p.body ?? '';
      renderPreview();
    };

    const apiFetch = async (url, opts = {}) => {
      const res = await fetch(url, { ...opts, headers: { ...(opts.headers || {}), 'x-write-key': getKey() } });
      if (res.status === 401) throw new Error('密钥错误或未设置');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '请求失败');
      return data;
    };

    const loadPosts = async () => {
      const k = getKey();
      if (!k) { authStatus.textContent = '先输入密钥。'; return; }
      try {
        posts = await apiFetch('/api/posts');
        renderList();
        authStatus.textContent = `已加载 ${posts.length} 篇文章`;
      } catch (err) {
        authStatus.textContent = err.message;
      }
    };

    const renderList = () => {
      postList.innerHTML = posts.map(p => `<li><button class="post-item-btn ${p._id === selectedId ? 'active' : ''}" data-id="${p._id}" type="button"><strong>${p.title}</strong><span>${p.pubDate ? p.pubDate.slice(0, 10) : ''}</span></button></li>`).join('')
        || '<li class="muted" style="padding:0.5rem;">暂无文章</li>';
    };

    const renderPreview = () => {
      preview.innerHTML = marked.parse(bodyEl.value || '*（暂无内容）*', { breaks: true, gfm: true });
      wordcount.textContent = `${(bodyEl.value || '').replace(/\s/g, '').length} 字`;
    };

    // events
    $('btn-load')?.addEventListener('click', () => {
      const k = keyEl.value.trim();
      if (k) setKey(k);
      loadPosts();
    });
    $('btn-new')?.addEventListener('click', clearForm);
    [titleEl, slugEl, tagsEl, descEl, dateEl, bodyEl].forEach(el => el.addEventListener('input', renderPreview));

    postList.addEventListener('click', (e) => {
      const btn = e.target?.closest?.('.post-item-btn');
      if (!btn) return;
      const p = posts.find(x => x._id === btn.dataset.id);
      if (p) fillForm(p);
    });

    $('btn-save')?.addEventListener('click', async () => {
      const title = titleEl.value.trim();
      if (!title) { status.textContent = '标题不能为空'; return; }
      status.textContent = '保存中…';
      try {
        const saved = await apiFetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _id: selectedId ?? undefined,
            title,
            slug: slugEl.value.trim() || undefined,
            description: descEl.value.trim(),
            pubDate: dateEl.value,
            tags: tagsEl.value.split(/[,，]/).map(s => s.trim()).filter(Boolean),
            body: bodyEl.value,
          }),
        });
        status.textContent = `已发布 ✓`;
        await loadPosts();
        fillForm(saved);
      } catch (err) {
        status.textContent = err.message;
      }
    });

    $('btn-delete')?.addEventListener('click', async () => {
      if (!selectedId) { status.textContent = '还没选择文章'; return; }
      if (!confirm('确定删除这篇？')) return;
      status.textContent = '删除中…';
      try {
        await apiFetch(`/api/posts?id=${selectedId}`, { method: 'DELETE' });
        status.textContent = '已删除';
        clearForm();
        await loadPosts();
      } catch (err) {
        status.textContent = err.message;
      }
    });

    // init
    if (getKey()) {
      keyEl.value = getKey();
      loadPosts();
    }
    renderPreview();
  </script>
</BaseLayout>
